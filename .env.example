# Copy to .env and replace both placeholders with separate random secrets.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret
MONGO_URI=mongodb://mongo:27017/tdk-ai-chat
CLIENT_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
LLM_PROVIDER=mock
AUTH_RATE_LIMIT_MAX=10
CHAT_STREAM_RATE_LIMIT_MAX=20
SSE_HEARTBEAT_MS=15000
